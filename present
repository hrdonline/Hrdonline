const MODES = {
  presentation: {
    label: "Презентация",
    icon: "▤",
    desc: "PPTX — слайды для выступлений и питчей",
    accent: "#6C63FF",
    bg: "#0D0B1E",
  },
  digest: {
    label: "Дайджест",
    icon: "◈",
    desc: "HTML — красивый документ для рассылки",
    accent: "#00C9A7",
    bg: "#071A17",
  },
