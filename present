};

const SLIDE_COUNTS = [5, 7, 10, 12, 15];

// ── Claude API helpers ──────────────────────────────────────────────────────

// pdfBase64: optional base64 string of PDF to send as document block
async function callClaude(systemPrompt, userText, pdfBase64 = null) {
  let content;
  if (pdfBase64) {
    content = [
      { type: "text", text: userText || "Используй содержимое документа." },
      {
        type: "document",
        source: { type: "base64", media_type: "application/pdf", data: pdfBase64 },
      },
    ];
  } else {
    content = userText;
  }

  const res = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      model: "claude-sonnet-4-5",
      max_tokens: 4000,
      system: systemPrompt,
      messages: [{ role: "user", content }],
    }),
  });
  const data = await res.json();
  if (!res.ok) {
    const msg = data?.error?.message || JSON.stringify(data?.error) || `API error ${res.status}`;
    throw new Error(msg);
  }
  return data.content.filter((b) => b.type === "text").map((b) => b.text).join("");
}

function extractJSON(raw) {
  const clean = raw.replace(/```json\s*/gi, "").replace(/```\s*/g, "").trim();
  const first = clean.indexOf("{");
  const last = clean.lastIndexOf("}");
  if (first === -1 || last === -1) throw new Error("No JSON found");
  return JSON.parse(clean.slice(first, last + 1));
}

function readFileAsBase64(file) {
  return new Promise((res, rej) => {
    const r = new FileReader();
    r.onload = () => res(r.result.split(",")[1]);
    r.onerror = () => rej(new Error("Не удалось прочитать файл"));
    r.readAsDataURL(file);
  });
}

function readFileAsText(file) {
  return new Promise((res, rej) => {
    const r = new FileReader();
    r.onload = (e) => res(e.target.result);
    r.onerror = () => rej(new Error("Не удалось прочитать файл"));
    r.readAsText(file);
  });
}

// ── PPTX generation via PptxGenJS in browser (CDN) ─────────────────────────

function loadScript(src) {
  return new Promise((res, rej) => {
    if (document.querySelector(`script[src="${src}"]`)) { res(); return; }
    const s = document.createElement("script");
    s.src = src;
    s.onload = res;
    s.onerror = rej;
    document.head.appendChild(s);
  });
}

const PALETTE = {
  "Executive Dark": { bg: "0D0B1E", title: "6C63FF", text: "E8E6FF", accent: "FF6584", sub: "9795B5" },
  "Clean Light":    { bg: "F8F9FC", title: "1A1A2E", text: "333355", accent: "4F46E5", sub: "888AAA" },
  "Bold Color":     { bg: "1A0533", title: "FF6584", text: "F0EAF8", accent: "00C9A7", sub: "B09FC0" },
};

async function generatePPTX(slides, styleKey, title) {
  await loadScript("https://cdnjs.cloudflare.com/ajax/libs/pptxgenjs/3.12.0/pptxgen.bundle.js");
  // eslint-disable-next-line no-undef
  const pres = new PptxGenJS();
  pres.layout = "LAYOUT_16x9";
  pres.title = title;

  const pal = PALETTE[styleKey] || PALETTE["Executive Dark"];

  slides.forEach((slide, i) => {
    const s = pres.addSlide();
    s.background = { color: pal.bg };

    const isCover = i === 0;

    if (isCover) {
      s.addShape(pres.shapes.RECTANGLE, { x: 0, y: 0, w: 0.18, h: 5.625, fill: { color: pal.accent } });
      s.addShape(pres.shapes.RECTANGLE, { x: 0.18, y: 0, w: 9.82, h: 5.625, fill: { color: pal.bg } });
      s.addText(slide.title, {
        x: 0.6, y: 1.2, w: 8.5, h: 1.8, fontSize: 40, bold: true,
        color: pal.title, fontFace: "Georgia", align: "left", margin: 0,
      });
      if (slide.subtitle) {
        s.addText(slide.subtitle, {
          x: 0.6, y: 3.2, w: 7.5, h: 0.8, fontSize: 18,
          color: pal.sub, fontFace: "Calibri", align: "left", margin: 0,
        });
      }
      s.addShape(pres.shapes.RECTANGLE, { x: 0.6, y: 2.9, w: 1.2, h: 0.06, fill: { color: pal.accent } });
    } else {
      s.addShape(pres.shapes.RECTANGLE, { x: 0, y: 0, w: 10, h: 0.85, fill: { color: pal.title } });
      s.addText(slide.title, {
        x: 0.4, y: 0.1, w: 9.2, h: 0.65, fontSize: 22, bold: true,
        color: "FFFFFF", fontFace: "Georgia", align: "left", margin: 0,
      });
      s.addText(String(i), {
        x: 8.8, y: 0.15, w: 0.6, h: 0.55, fontSize: 11,
        color: "FFFFFF", fontFace: "Calibri", align: "right", margin: 0,
      });

      if (slide.body && slide.body.length > 0) {
        const bodyItems = slide.body.map((b, bi) => ({
          text: b,
          options: { bullet: true, breakLine: bi < slide.body.length - 1, paraSpaceAfter: 6 },
        }));
        s.addText(bodyItems, {
          x: 0.45, y: 1.1, w: slide.stat ? 5.6 : 9.1, h: 4.0,
          fontSize: 15, color: pal.text, fontFace: "Calibri", valign: "top", margin: 0,
        });
      }

      if (slide.stat) {
        s.addShape(pres.shapes.RECTANGLE, {
          x: 6.5, y: 1.1, w: 3.1, h: 4.0,
          fill: { color: pal.accent, transparency: 88 },
        });
        s.addText(slide.stat.value, {
          x: 6.5, y: 1.7, w: 3.1, h: 1.4, fontSize: 52, bold: true,
          color: pal.accent, fontFace: "Georgia", align: "center", margin: 0,
        });
        s.addText(slide.stat.label, {
          x: 6.5, y: 3.2, w: 3.1, h: 1.5, fontSize: 13,
          color: pal.text, fontFace: "Calibri", align: "center", margin: 0,
        });
      }
    }
  });

  const blob = await pres.write({ outputType: "blob" });
  return blob;
}

// ── Digest HTML generation ──────────────────────────────────────────────────

const DIGEST_THEMES = {
  "Верхний этаж": {
    bg: "#0D0B1E", card: "#16133A", accent: "#6C63FF", text: "#E8E6FF",
    sub: "#9795B5", name: "Верхний этаж",
  },
  "ИИ в HR": {
    bg: "#071A17", card: "#0E2922", accent: "#00C9A7", text: "#DFF7F2",
    sub: "#7CBFB6", name: "ИИ в HR",
  },
  "Нейтральный": {
    bg: "#F4F4F8", card: "#FFFFFF", accent: "#4F46E5", text: "#1A1A2E",
    sub: "#6B7280", name: "Дайджест",
  },
};

function buildDigestHTML(data, themeKey) {
  const t = DIGEST_THEMES[themeKey] || DIGEST_THEMES["Нейтральный"];
  const items = (data.items || []).map((item) => `
    <div style="background:${t.card};border-radius:12px;padding:24px 28px;margin-bottom:20px;border-left:4px solid ${t.accent}">
      <div style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:${t.sub};margin-bottom:8px">${item.tag || "МАТЕРИАЛ"}</div>
      <h2 style="margin:0 0 10px;font-size:19px;font-weight:700;color:${t.accent};font-family:'Georgia',serif">${item.title}</h2>
      <p style="margin:0 0 12px;font-size:14px;line-height:1.7;color:${t.text}">${item.body}</p>
      ${item.insight ? `<div style="background:${t.accent}22;border-radius:8px;padding:12px 16px;font-size:13px;color:${t.text};font-style:italic">💡 ${item.insight}</div>` : ""}
    </div>`).join("");

  const quote = data.quote ? `
    <div style="background:${t.accent}18;border-radius:16px;padding:32px;margin:32px 0;text-align:center">
      <p style="font-size:20px;font-family:'Georgia',serif;color:${t.accent};margin:0 0 12px;line-height:1.5">"${data.quote.text}"</p>
      <div style="font-size:12px;color:${t.sub}">${data.quote.author}</div>
    </div>` : "";

  return `<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>${data.title}</title>
<style>*{box-sizing:border-box}body{margin:0;font-family:'Calibri',sans-serif;background:${t.bg};color:${t.text}}
a{color:${t.accent}}.wrap{max-width:680px;margin:0 auto;padding:40px 20px}</style>
</head><body><div class="wrap">
<div style="text-align:center;padding:40px 0 32px">
  <div style="font-size:12px;letter-spacing:3px;text-transform:uppercase;color:${t.sub};margin-bottom:12px">${t.name}</div>
  <h1 style="margin:0;font-size:28px;font-weight:700;color:${t.accent};font-family:'Georgia',serif">${data.title}</h1>
  ${data.subtitle ? `<p style="font-size:14px;color:${t.sub};margin:12px 0 0">${data.subtitle}</p>` : ""}
</div>
${data.lead ? `<p style="font-size:16px;line-height:1.8;color:${t.text};border-top:1px solid ${t.accent}44;padding-top:24px;margin-bottom:32px">${data.lead}</p>` : ""}
${items}
${quote}
<div style="text-align:center;padding:32px 0 12px;border-top:1px solid ${t.accent}33;font-size:12px;color:${t.sub}">
  ${data.footer || "Зинаида Чумакова · hrdonline.ru"}
</div>
</div></body></html>`;
}

// ── UI ──────────────────────────────────────────────────────────────────────

export default function DesignAgent() {
  const [mode, setMode] = useState("presentation");
  const [style, setStyle] = useState(STYLES.presentation[0]);
  const [slideCount, setSlideCount] = useState(7);
  const [topic, setTopic] = useState("");
  const [fileText, setFileText] = useState("");   // txt/md content
  const [filePDF, setFilePDF] = useState(null);   // base64 PDF string
  const [fileName, setFileName] = useState("");
  const [step, setStep] = useState("input"); // input | generating | done | error
  const [log, setLog] = useState([]);
  const [result, setResult] = useState(null);
  const [previewHTML, setPreviewHTML] = useState(null);
  const fileRef = useRef();

  const addLog = useCallback((msg) => setLog((p) => [...p, msg]), []);

  function handleModeSwitch(m) {
    setMode(m);
    setStyle(STYLES[m][0]);
    setResult(null);
    setPreviewHTML(null);
    setStep("input");
    setLog([]);
  }

  async function handleFile(e) {
    const f = e.target.files[0];
    if (!f) return;
    setFileName(f.name);
    if (f.type === "application/pdf" || f.name.toLowerCase().endsWith(".pdf")) {
      const b64 = await readFileAsBase64(f);
      setFilePDF(b64);
      setFileText("");
    } else {
      const text = await readFileAsText(f);
      setFileText(text);
      setFilePDF(null);
    }
  }

  function clearFile() {
    setFileName("");
    setFileText("");
    setFilePDF(null);
    if (fileRef.current) fileRef.current.value = "";
  }

  async function generate() {
    const hasInput = topic.trim() || fileText.trim() || filePDF;
    if (!hasInput) return;
    setStep("generating");
    setLog([]);
    setResult(null);
    setPreviewHTML(null);

    const textInput = [topic, fileText].filter(Boolean).join("\n\n").trim() || "Используй содержимое документа.";

    try {
      if (mode === "presentation") {
        addLog(filePDF ? "Читаю PDF…" : "Анализирую тему…");
        const systemPPTX = `Ты дизайнер презентаций. Создай структуру слайдов в JSON.
Верни ТОЛЬКО валидный JSON без markdown-блоков.
Формат: { "title": "...", "slides": [ { "title": "...", "subtitle": "...", "body": ["...","..."], "stat": { "value": "42%", "label": "описание" } } ] }
Первый слайд — титульный (subtitle обязателен). Остальные слайды — без subtitle.
Поле stat необязательно — добавляй только если есть конкретная цифра. body — список из 3–5 коротких пунктов.
Количество слайдов: ${slideCount}. Язык: русский. Стиль: профессиональный, ёмкий.`;
        const raw = await callClaude(systemPPTX, textInput, filePDF || null);
        addLog("Структура готова, генерирую PPTX…");
        const data = extractJSON(raw);
        const blob = await generatePPTX(data.slides, style, data.title);
        const url = URL.createObjectURL(blob);
        const safeName = (data.title || "presentation").replace(/[^а-яёa-z0-9_-]/gi, "_").slice(0, 40);
        setResult({ url, name: `${safeName}.pptx` });
        addLog("✓ Готово!");
        setStep("done");
      } else {
        addLog(filePDF ? "Читаю PDF…" : "Составляю структуру дайджеста…");
        const systemDigest = `Ты редактор экспертного дайджеста. Создай JSON структуру дайджеста.
Верни ТОЛЬКО валидный JSON без markdown-блоков.
Формат: { "title": "...", "subtitle": "...", "lead": "вводный абзац", "items": [ { "tag": "ТРЕНД", "title": "...", "body": "2-3 предложения", "insight": "ключевой вывод" } ], "quote": { "text": "...", "author": "..." }, "footer": "Зинаида Чумакова · hrdonline.ru" }
items — 4-6 штук. Теги: ТРЕНД, КЕЙС, ДАННЫЕ, МНЕНИЕ, ИНСТРУМЕНТ, КНИГА. Язык: русский. quote необязателен.`;
        const raw = await callClaude(systemDigest, textInput, filePDF || null);
        addLog("Структура готова, верстаю HTML…");
        const data = extractJSON(raw);
        const html = buildDigestHTML(data, style);
        const blob = new Blob([html], { type: "text/html" });
        const url = URL.createObjectURL(blob);
        const safeName = (data.title || "digest").replace(/[^а-яёa-z0-9_-]/gi, "_").slice(0, 40);
        setResult({ url, name: `${safeName}.html` });
        setPreviewHTML(html);
        addLog("✓ Готово!");
        setStep("done");
      }
    } catch (err) {
      addLog(`Ошибка: ${err.message}`);
      setStep("error");
    }
  }

  const m = MODES[mode];
  const isPDF = fileName.toLowerCase().endsWith(".pdf");
  const hasInput = topic.trim() || fileText.trim() || filePDF;

  return (
    <div style={{ minHeight: "100vh", background: "#09090F", color: "#E8E6FF", fontFamily: "'Calibri', sans-serif", padding: "32px 16px" }}>
      <div style={{ maxWidth: 700, margin: "0 auto" }}>

        {/* Header */}
        <div style={{ textAlign: "center", marginBottom: 36 }}>
          <div style={{ fontSize: 11, letterSpacing: 3, textTransform: "uppercase", color: "#6B6B9B", marginBottom: 10 }}>
            Агент-дизайнер
          </div>
          <h1 style={{ margin: 0, fontSize: 28, fontWeight: 700, fontFamily: "Georgia, serif", background: "linear-gradient(135deg, #6C63FF, #00C9A7)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent" }}>
            Презентации & Дайджесты
          </h1>
        </div>

        {/* Mode switcher */}
        <div style={{ display: "flex", gap: 12, marginBottom: 28 }}>
          {Object.entries(MODES).map(([key, val]) => (
            <button key={key} onClick={() => handleModeSwitch(key)}
              style={{ flex: 1, padding: "16px 12px", borderRadius: 12, border: `2px solid ${mode === key ? val.accent : "#2A2A4A"}`,
                background: mode === key ? `${val.accent}18` : "#12121F", color: mode === key ? val.accent : "#9795B5",
                cursor: "pointer", transition: "all .2s", textAlign: "left" }}>
              <div style={{ fontSize: 20, marginBottom: 4 }}>{val.icon}</div>
              <div style={{ fontWeight: 700, fontSize: 15 }}>{val.label}</div>
              <div style={{ fontSize: 12, opacity: .7, marginTop: 2 }}>{val.desc}</div>
            </button>
          ))}
        </div>

        {/* Config */}
        <div style={{ background: "#12121F", borderRadius: 14, padding: 24, marginBottom: 20, border: "1px solid #1E1E3A" }}>
          <div style={{ display: "flex", gap: 16, flexWrap: "wrap", marginBottom: 20 }}>
            <div style={{ flex: 1, minWidth: 160 }}>
              <label style={{ fontSize: 11, letterSpacing: 1, textTransform: "uppercase", color: "#6B6B9B", display: "block", marginBottom: 8 }}>Стиль</label>
              <select value={style} onChange={(e) => setStyle(e.target.value)}
                style={{ width: "100%", background: "#1A1A30", border: "1px solid #2A2A4A", color: "#E8E6FF", padding: "9px 12px", borderRadius: 8, fontSize: 14 }}>
                {STYLES[mode].map((s) => <option key={s}>{s}</option>)}
              </select>
            </div>
            {mode === "presentation" && (
              <div style={{ flex: 1, minWidth: 160 }}>
                <label style={{ fontSize: 11, letterSpacing: 1, textTransform: "uppercase", color: "#6B6B9B", display: "block", marginBottom: 8 }}>Слайдов</label>
                <select value={slideCount} onChange={(e) => setSlideCount(Number(e.target.value))}
                  style={{ width: "100%", background: "#1A1A30", border: "1px solid #2A2A4A", color: "#E8E6FF", padding: "9px 12px", borderRadius: 8, fontSize: 14 }}>
                  {SLIDE_COUNTS.map((n) => <option key={n}>{n}</option>)}
                </select>
              </div>
            )}
          </div>

          {/* Topic input */}
          <label style={{ fontSize: 11, letterSpacing: 1, textTransform: "uppercase", color: "#6B6B9B", display: "block", marginBottom: 8 }}>Тема или тезисы</label>
          <textarea value={topic} onChange={(e) => setTopic(e.target.value)}
            placeholder={mode === "presentation"
              ? "Например: Фракциональный HRD — новая модель для среднего бизнеса. Тезисы: проблема найма, что такое фракциональная модель, кейсы, стоимость vs штатный HRD."
              : "Например: Дайджест «Верхний этаж» №12. Темы: ИИ в рекрутинге, кейс Novametrix, тренды рынка труда 2026."}
            style={{ width: "100%", background: "#1A1A30", border: "1px solid #2A2A4A", color: "#E8E6FF", padding: "12px 14px", borderRadius: 8, fontSize: 14, minHeight: 100, resize: "vertical", outline: "none", fontFamily: "inherit" }} />

          {/* File upload */}
          <div style={{ marginTop: 14 }}>
            {!fileName ? (
              <button onClick={() => fileRef.current.click()}
                style={{ background: "none", border: "1px dashed #2A2A4A", color: "#9795B5", padding: "10px 18px", borderRadius: 8, cursor: "pointer", fontSize: 13 }}>
                + Загрузить документ (.txt, .md, .pdf)
              </button>
            ) : (
              <div style={{ display: "inline-flex", alignItems: "center", gap: 8, background: isPDF ? "#6C63FF18" : "#1A1A30", border: `1px solid ${isPDF ? "#6C63FF55" : "#2A2A4A"}`, borderRadius: 8, padding: "8px 14px" }}>
                <span style={{ fontSize: 16 }}>{isPDF ? "📑" : "📄"}</span>
                <span style={{ fontSize: 13, color: isPDF ? "#A8A3FF" : "#9795B5" }}>{fileName}</span>
                {isPDF && <span style={{ fontSize: 11, color: "#6C63FF", background: "#6C63FF22", padding: "2px 7px", borderRadius: 4, letterSpacing: 1 }}>PDF</span>}
                <button onClick={clearFile}
                  style={{ background: "none", border: "none", color: "#FF6584", cursor: "pointer", fontSize: 14, padding: 0, lineHeight: 1 }}>✕</button>
              </div>
            )}
            <input ref={fileRef} type="file" accept=".txt,.md,.csv,.pdf" style={{ display: "none" }} onChange={handleFile} />
          </div>
        </div>

        {/* Generate button */}
        <button onClick={generate} disabled={step === "generating" || !hasInput}
          style={{ width: "100%", padding: "16px", borderRadius: 12, border: "none",
            background: (step === "generating" || !hasInput) ? "#2A2A4A" : `linear-gradient(135deg, ${m.accent}, ${mode === "presentation" ? "#FF6584" : "#6C63FF"})`,
            color: (step === "generating" || !hasInput) ? "#6B6B9B" : "white",
            fontSize: 16, fontWeight: 700, cursor: (step === "generating" || !hasInput) ? "not-allowed" : "pointer", letterSpacing: .5 }}>
          {step === "generating" ? "Генерирую…" : `Создать ${m.label} →`}
        </button>

        {/* Log */}
        {log.length > 0 && (
          <div style={{ marginTop: 20, background: "#0D0D1A", borderRadius: 10, padding: "14px 18px", border: "1px solid #1E1E3A" }}>
            {log.map((l, i) => (
              <div key={i} style={{ fontSize: 13, color: l.startsWith("✓") ? "#00C9A7" : l.startsWith("Ошибка") ? "#FF6584" : "#9795B5", padding: "2px 0" }}>
                {l}
              </div>
            ))}
          </div>
        )}

        {/* Result */}
        {result && step === "done" && (
          <div style={{ marginTop: 20, background: `${m.accent}12`, borderRadius: 12, padding: 24, border: `1px solid ${m.accent}44`, textAlign: "center" }}>
            <div style={{ fontSize: 28, marginBottom: 8 }}>✓</div>
            <div style={{ fontSize: 15, color: "#E8E6FF", marginBottom: 16 }}>{result.name}</div>
            <a href={result.url} download={result.name}
              style={{ display: "inline-block", padding: "12px 32px", borderRadius: 10,
                background: m.accent, color: "white", textDecoration: "none", fontWeight: 700, fontSize: 15 }}>
              Скачать файл
            </a>
            {previewHTML && (
              <button onClick={() => {
                const w = window.open("", "_blank");
                w.document.write(previewHTML);
                w.document.close();
              }}
                style={{ marginLeft: 12, padding: "12px 24px", borderRadius: 10, background: "none",
                  border: `1px solid ${m.accent}`, color: m.accent, cursor: "pointer", fontWeight: 700, fontSize: 15 }}>
                Превью
              </button>
            )}
            <div style={{ marginTop: 14 }}>
              <button onClick={() => { setStep("input"); setResult(null); setPreviewHTML(null); setLog([]); }}
                style={{ background: "none", border: "none", color: "#9795B5", cursor: "pointer", fontSize: 13 }}>
                ← Создать ещё
              </button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
